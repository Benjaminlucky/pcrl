# Copy to .env and fill in with the SAME values the app uses today
# (e.g. copy them from Railway → Variables). Never commit the real .env.

# --- Core -------------------------------------------------------------------
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/pcrg?retryWrites=true&w=majority
# Use the SAME value as today — a different one logs every user out.
JWT_SECRET=same-value-as-currently-on-railway
# Not needed on DirectAdmin/Passenger (it assigns the port). Used locally.
PORT=3000

# Comma-separated list of sites allowed to call the API from a browser.
# Leave empty to allow any origin (previous behaviour).
CORS_ORIGINS=https://pcrginitiative.com,https://www.pcrginitiative.com

# --- Media (Cloudinary) -----------------------------------------------------
# Leave these three EMPTY to keep using the Cloudinary account built into
# utils/cloudinary.config.js (current behaviour). Only fill them in if you
# already set them on Railway — then copy those exact values.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folder that CMS media-library uploads go into
CLOUDINARY_MEDIA_FOLDER=pcrg/site

# --- Email ------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_NOTIFY_EMAILS=
WELCOME_EMAIL_INCLUDE_PASSWORD=false

# --- Site -------------------------------------------------------------------
FRONTEND_URL=https://pcrginitiative.com
SITE_URL=https://pcrginitiative.com

# Optional: require this header value to use POST /api/admin/signup
ADMIN_SIGNUP_SECRET=

# Optional, legacy blog/events revalidation webhook (safe to leave empty)
REVALIDATE_URL=
REVALIDATE_SECRET=
